{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "build": "nuxt build",
    "clean": "rimraf .nuxt dist .cache .output node_modules .lighthouseci .wrangler .unlighthouse",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lintfix": "prettier --write --list-different . && pnpm lint:js --fix"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/image": "^1.11.2",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^8.6.2",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript-eslint/parser": "^6.21.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-universe": "^12.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "nuxt": "^3.21.11",
    "nuxt-icon": "^0.6.10",
    "prettier": "^3.10.0",
    "rimraf": "^5.0.10",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^9.4.3",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.4"
  },
  "packageManager": "pnpm@9.1.1",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "minimatch@>=9 <9.0.7": "^9.0.7",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "unhead@<2.1.13": "^2.1.13",
      "@nuxtjs/mdc": "^0.22.1"
    }
  }
}
